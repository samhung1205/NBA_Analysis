{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],

  // ────────────────────────────────────────────────────────────
  // 開發期資料庫：D1 (local SQLite)
  //
  // ⚠️ 規格書 §0 銜接原則：正式環境必須改用「階段二 Python 服務也連得到的
  //    獨立 Postgres」(Supabase / Railway)。做法：
  //      1. 在 Supabase 建立專案，取得連線字串
  //      2. 對該 DB 執行 migrations/postgres/0001_init.sql
  //      3. 設定 secret：npx wrangler pages secret put DATABASE_URL
  //    只要 DATABASE_URL 存在，src/db 會自動改用 Postgres 驅動，
  //    不需修改任何程式碼；D1 僅作為沙盒開發期的便利選項。
  // ────────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "local-dev-placeholder"
    }
  ],

  // ────────────────────────────────────────────────────────────
  // ⚠️ 帶 pages_build_output_dir 的 wrangler 檔，`wrangler pages deploy` 會把「上面這份本機設定」
  //    當成 production 設定。上面的 D1 是本機沙盒佔位（local-dev-placeholder），不可帶進線上：
  //    線上一律走 Postgres（DATABASE_URL secret），所以 production / preview 明確清空 D1 binding。
  //    本機 `wrangler pages dev` 仍使用上面的 D1。
  // ────────────────────────────────────────────────────────────
  "env": {
    "production": { "d1_databases": [] },
    "preview": { "d1_databases": [] }
  }
}
