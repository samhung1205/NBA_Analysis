# ============================================================
# NBA 對戰預測平台 — 環境變數
# 階段一（Hono/Cloudflare Pages）與階段二（Python 資料工程 + ML）共用同一組。
# 本機開發請複製為 .dev.vars（Cloudflare）或 .env（Python），且勿提交進 git。
# ============================================================

# ─────────────── 【必要】共用資料庫（階段一 + 階段二） ───────────────
# 規格書 §0：必須是「Cloudflare Pages 與外部 Python 服務都連得到」的獨立 Postgres。
# Supabase 取得方式：Project → Settings → Database → Connection string (URI)
#
#   ⚠️ 2026-08 實測修正：Cloudflare Workers 請用 Supabase 的
#      "Session pooler"（pooler host + port 5432），不要用 "Transaction pooler"
#      （pooler host + port 6543）。
#      實測 Transaction pooler 搭配 postgres.js 在 Workers runtime 下會間歇性
#      卡死請求（"Worker's code had hung"），換成 Session pooler 後穩定通過
#      90 項 smoke test 與並行壓力測試。兩者 host 相同，只有 port 不同。
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# 階段二 Python 排程器：優先用同一組 Session pooler URL（上面那條）即可。
#   ⚠️ Supabase 的「直連」位址 db.xxxxxxxx.supabase.co:5432 只有 IPv6，
#      若排程器所在網路無 IPv6 出口（許多家用/雲端環境皆如此）會直接連不上
#      （connect EHOSTUNREACH）。除非確認網路支援 IPv6，否則不要用直連。
# DATABASE_URL_DIRECT="postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# ─────────────── 【必要】階段一：Session 簽章金鑰 ───────────────
# 用於簽署登入 cookie。請用隨機字串（32 字元以上）：
#   openssl rand -base64 32
SESSION_SECRET="請改成你自己的隨機字串至少32字元"
# 正式環境（已設 DATABASE_URL）缺少 / 過短（<32）/ 等於開發預設值時，登入 API 會直接拒絕（fail closed）。
# 正式環境註冊預設關閉（已有任何使用者後）；建立你自己的帳號時才暫時設 ALLOW_REGISTRATION="true"，建好後移除。
# 密碼雜湊：Cloudflare WebCrypto 的 PBKDF2 目前最多 100,000 次迭代（再高會丟 NotSupportedError），新雜湊用 runtime 上限；
# 這不等同 210,000 次，所以新註冊密碼至少 12 字元。登入不檢查長度；儲存的迭代數超過上限的舊雜湊會安全地登入失敗。
# 未來多人 / 公開部署應改用託管驗證（例如 Supabase Auth）。
# ALLOW_REGISTRATION="true"

# ─────────────── 階段二：Railway 排程器（見 docs/production-runbook.md） ───────────────
# MODEL_ARTIFACT_DIR="/data/model-artifacts"   # Railway volume 掛載點；未設定 = 映像內 pipeline/artifacts/production
# PG_POOL_MAX="4"                              # 排程器連線池上限（Supabase session pooler 全站共用約 15 條）

# ─────────────── 階段二：外部資料來源 ───────────────
# The Odds API（國際盤，免費層 500 credits/月）https://the-odds-api.com/
#   Phase D.1：全場 h2h,spreads,totals × 1 region = 3 credits/次；預設每日 4 次（≈ 372/月）。
#   先呼叫不扣額度的 /events，未來 48 小時沒有比賽就不花額度。上半場市場需逐場呼叫，免費方案預設關閉。
ODDS_API_KEY=""
ODDS_API_REGIONS="us"
# ODDS_API_BOOKMAKERS="draftkings,fanduel"   # 指定時優先於 regions
ODDS_API_INCLUDE_H1="false"
ODDS_API_QUOTA_RESERVE="25"                  # 剩餘額度低於此值 → 不再呼叫付費端點（quota_low）
ODDS_API_QUOTA_WARN="100"                    # 低於此值 → 系統狀態頁 warn
ODDS_API_CRON_HOURS="0,6,12,18"              # 台灣時間，每小時的 :40 執行

# balldontlie API（第二備援，免費層需註冊）https://www.balldontlie.io/
BALLDONTLIE_API_KEY=""

# NBA Stats API 標頭：一律使用 nba_api 套件內建的完整預設值，不再提供自訂 User-Agent 設定
# （自訂 UA 會與預設 Sec-Ch-Ua 互相矛盾，反而更容易被擋）。
# 請求間隨機延遲區間（秒），避免被封鎖
NBA_API_MIN_DELAY="1.5"
NBA_API_MAX_DELAY="4.0"

# 台灣運彩爬蟲（Playwright；Phase D.1）
#   盤口在 iframe 內的 ORAKO sportsbook（www-talo-ssb-pr.sportslottery.com.tw），網站以 Cloudflare 防護。
#   2026-10-04 實測：自動化瀏覽器（headless 或一般視窗）呼叫其 JSON 端點皆被擋（403），本專案**不繞過**；
#   job 會回報 blocked（連續 3 次後 6 小時退避）。合規備援：一般瀏覽器 DevTools 匯出 HAR →
#   python run_odds.py --source twsport --from-file capture.har
TWSPORT_BASE_URL="https://www.sportslottery.com.tw/"
TWSPORT_SCRAPE_INTERVAL_MIN="30"
TWSPORT_ENABLED="true"
TWSPORT_HEADLESS="true"
TWSPORT_BROWSER_CHANNEL="chrome"             # 使用本機 Google Chrome；留空 = Playwright 內建 chromium（需 playwright install chromium）
# 免費 Chrome 同步（browser-sync-v1，預設停用；完整指南 docs/browser-sync-guide.md）
# 網站與 Python 排程器都需 true；啟用時一般台彩自動爬蟲不執行。
# 啟用前需 0013 migration 與使用者載入未封裝擴充套件；不代表台彩已授權資料轉載。
TWSPORT_SYNC_ENABLED="false"
# 僅網站需設定，值由 scripts/build-twsport-extension.mjs 輸出（公開識別碼，不是密鑰）
TWSPORT_EXTENSION_ID=""
# 改版偵測告警（選填）
ALERT_WEBHOOK_URL=""

# ─────────────── 階段二：排程與模型參數 ───────────────
TZ="Asia/Taipei"
MODEL_VERSION="elo-v1.0"
# Independent model observability (requires 0014_model_observability.sql).
# Shadow data never feeds production inference / pricing / risk; activation is prospective only.
MODEL_MONITOR_ENABLED="true"
MODEL_SHADOW_ENABLED="false"
# Kelly / 單筆 / 同場 / 單日上限：Phase D.3 起凍結在 pipeline/core/sizing/policy.py（risk-v1），
# 不再提供環境變數（不得由部署設定或 ROI 結果調整；要改只能新增 policy 版本）。舊的 KELLY_FRACTION 已移除、不會被讀取。
# 台彩返還率（用於抽水估算，僅供參考，實務以實際賠率計算）
TWSPORT_PAYOUT_RATE="0.85"

# ─────────────── 階段二：Telegram 推播（Phase E.1 notify-v1，選用；排程器讀取） ───────────────
# 兩個都設定才會推播；未設定 = 推播 job 立即返回。需要資料庫已套用 0009_phase_e1_notifications.sql。
#   1. Telegram 找 @BotFather → /newbot → 取得 token
#   2. 傳任一訊息給你的 bot，再開 https://api.telegram.org/bot<token>/getUpdates 找 "chat":{"id": ...}
#   3. 設定後執行：cd pipeline && .venv/bin/python run_notify.py --test
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# TELEGRAM_NOTIFY_USER_ID="1"            # 網站有多位使用者時必填：要推播哪一位的決策中心
# TELEGRAM_NOTIFY_INCLUDE_REVIEW="false" # true = 也推播 REVIEW（有資料品質旗標的 qualified 機會；開季初期多數在此組）
# NOTIFY_SITE_URL="https://<你的網站>"     # 訊息附上網站連結（選填）
# LINE_CHANNEL_ACCESS_TOKEN=""           # 尚未實作（LINE Notify 已停止服務；需 Messaging API）

# ─────────────── 開發期選項（僅階段一沙盒） ───────────────
# 不設定 DATABASE_URL 時，階段一會退回使用 Cloudflare D1 (local SQLite)，
# 方便在沒有 Postgres 的環境下開發／驗證 UI。
# ⚠️ D1 僅供開發：階段二的 Python 服務無法連線，正式環境務必設定 DATABASE_URL。
