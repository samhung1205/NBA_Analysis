# ============================================================
# NBA 對戰預測平台 — 環境變數
# 階段一（Hono/Cloudflare Pages）與階段二（Python 資料工程 + ML）共用同一組。
# 本機開發請複製為 .dev.vars（Cloudflare）或 .env（Python），且勿提交進 git。
# ============================================================

# ─────────────── 【必要】共用資料庫（階段一 + 階段二） ───────────────
# 規格書 §0：必須是「Cloudflare Pages 與外部 Python 服務都連得到」的獨立 Postgres。
# Supabase 取得方式：Project → Settings → Database → Connection string (URI)
#   ⚠️ 給 Cloudflare Workers 用請選 "Connection pooling"（Transaction mode，port 6543），
#      Serverless 環境不可用 Session mode 的直連 5432。
#   ⚠️ 階段二 Python 排程器可用直連 5432（Session mode），效能較好。
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# 階段二 Python 服務專用（若與上面不同，例如用直連 port）
# DATABASE_URL_DIRECT="postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# ─────────────── 【必要】階段一：Session 簽章金鑰 ───────────────
# 用於簽署登入 cookie。請用隨機字串（32 字元以上）：
#   openssl rand -base64 32
SESSION_SECRET="請改成你自己的隨機字串至少32字元"

# ─────────────── 階段二：外部資料來源 ───────────────
# The Odds API（國際盤，免費層 500 req/月）https://the-odds-api.com/
ODDS_API_KEY=""

# balldontlie API（第二備援，免費層需註冊）https://www.balldontlie.io/
BALLDONTLIE_API_KEY=""

# NBA Stats API 偽裝用 User-Agent（stats.nba.com 會封鎖無 headers 的請求）
NBA_API_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
# 請求間隨機延遲區間（秒），避免被封鎖
NBA_API_MIN_DELAY="1.5"
NBA_API_MAX_DELAY="4.0"

# 台灣運彩爬蟲（Playwright）
TWSPORT_BASE_URL="https://www.sportslottery.com.tw/"
TWSPORT_SCRAPE_INTERVAL_MIN="30"
# 改版偵測告警（選填）
ALERT_WEBHOOK_URL=""

# ─────────────── 階段二：排程與模型參數 ───────────────
TZ="Asia/Taipei"
MODEL_VERSION="elo-v1.0"
# Kelly 上限（規格書 §4 Phase D-15：預設 1/4 Kelly）
KELLY_FRACTION="0.25"
# 台彩返還率（用於抽水估算，僅供參考，實務以實際賠率計算）
TWSPORT_PAYOUT_RATE="0.85"

# ─────────────── 階段二：推播（Phase E 選做） ───────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
LINE_CHANNEL_ACCESS_TOKEN=""

# ─────────────── 開發期選項（僅階段一沙盒） ───────────────
# 不設定 DATABASE_URL 時，階段一會退回使用 Cloudflare D1 (local SQLite)，
# 方便在沒有 Postgres 的環境下開發／驗證 UI。
# ⚠️ D1 僅供開發：階段二的 Python 服務無法連線，正式環境務必設定 DATABASE_URL。
